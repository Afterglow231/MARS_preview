# Exact upstream source/runtime pins used by setup_agent_cli.sh and
# enforced again by run_workload.py.
OPENCODE_REPO_URL=https://github.com/anomalyco/opencode.git
OPENCODE_TAG=v1.18.23
OPENCODE_COMMIT=ef2880f379129aa048be9e9353e30aa168d42c17
OPENCODE_VERSION=1.18.23

CODEX_REPO_URL=https://github.com/openai/codex.git
CODEX_TAG=rust-v0.149.1
CODEX_COMMIT=ff29a44391deccde0aba0f8390337d7f3c319ea4
CODEX_VERSION=0.149.1

# The npm launch shims use /usr/bin/env node even though the actual agent
# executables are version-pinned above. Keep the host-side runtime reproducible
# and bind this exact binary into each request sandbox.
NODE_VERSION=24.18.1
NPM_VERSION=11.16.0

